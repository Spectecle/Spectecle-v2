# Resend (transactional email) — used by /api/contact and the client portal.
# RESEND_FROM can only be an address on a domain verified in Resend
# (resend.com/domains). Until spectecle.com is verified there, this must
# stay onboarding@resend.dev, which can only deliver to the Resend account
# owner's own email — not real clients. Switch to hello@spectecle.com once
# the domain is verified; no code changes needed, every route reads this var.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
CONTACT_EMAIL=hello@spectecle.com

# Supabase — client portal storage. Run supabase/schema.sql in the Supabase
# SQL editor first, then copy these from Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe to expose to the browser — used only for direct-to-storage file
# uploads (the signed upload URL/token is the actual authorization).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of emails allowed into /portal/admin
ADMIN_EMAILS=admin@spectecle.com

# Absolute site URL, used to build magic-link URLs in emails
NEXT_PUBLIC_SITE_URL=https://spectecle.com

# Spectecle's own Google Business review link — used by the "Project Complete"
# client email (admin > Send Client Email) to ask clients for a review.
GOOGLE_REVIEW_URL=https://g.page/r/CbSs-g26jjLnEBM/review

# Google OAuth — powers two features, each authenticated as a DIFFERENT
# Google identity (a refresh token belongs to exactly one account, and can
# only see the GA4 properties / Gmail inbox that account has access to):
#   1. GA4 Data API, as accounts@spectecle.com — the "Fetch from GA4" button
#      on a client's Analytics card (admin > client detail), the LIVE
#      analytics panel on the client-facing dashboard for any org with a
#      ga4_property_id set (Growth/Pro tier), and Spectecle.com's own
#      visitor stats on the admin Dashboard (see SPECTECLE_GA4_PROPERTY_ID
#      below). Before generating this token, add accounts@spectecle.com as
#      a Viewer on every client GA4 property that doesn't already have it
#      (GA4 Admin > Property Access Management) — one consolidated identity
#      instead of juggling several.
#   2. Gmail API, as hello@spectecle.com — the "Emails Sent/Received" stats
#      on the admin Dashboard. Uses the narrower gmail.metadata scope
#      (message counts/headers only, never message bodies).
# The Client ID/Secret below identify the OAuth *application* and are
# shared by both; only the refresh tokens differ, one per identity.
# One-time setup:
#   1. In Google Cloud Console, enable both the "Google Analytics Data API"
#      and the "Gmail API".
#   2. APIs & Services > Credentials > Create Credentials > OAuth client ID
#      > Application type "Web application". Add
#      https://developers.google.com/oauthplayground as an authorized
#      redirect URI. Copy the Client ID and Client Secret below.
# Then, twice — once per identity:
#   3. Go to developers.google.com/oauthplayground, click the gear icon (top
#      right) > check "Use your own OAuth credentials" > paste the Client ID
#      and Secret from step 2.
#   4. Select ONLY the one relevant scope this round — "...analytics.readonly"
#      when signing in as accounts@spectecle.com, or "...gmail.metadata"
#      when signing in as hello@spectecle.com — click "Authorize APIs", and
#      sign in as that specific account (log out of other Google accounts
#      in that browser first if it tries to auto-pick the wrong one).
#   5. Click "Exchange authorization code for tokens" — copy the "Refresh
#      token" into the matching variable below. Repeat steps 3-5 for the
#      other identity.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_REFRESH_TOKEN=

# Spectecle.com's own GA4 property ID (the raw numeric ID, not "G-XXXXXXX"),
# for the admin Dashboard's own website-visit stats — separate from any
# client's property ID, which lives on their organization record instead.
SPECTECLE_GA4_PROPERTY_ID=

# Stripe — powers the portal's Free/Growth/Pro billing (checkout, the
# Customer Portal for self-serve upgrade/downgrade/card changes, and the
# webhook that keeps organizations.dashboard_tier in sync). Use a
# *restricted* key scoped to the "Recurring subscriptions and billing"
# permission template, plus Customers: Write (needed to create a Stripe
# customer on an org's first checkout — not included in that template by
# default). Use TEST MODE keys/prices (rk_test_...) for local dev; only
# swap to live (rk_live_...) once ready for real billing, per the Phase 1
# plan's Step 6 cutover.
STRIPE_SECRET_KEY=
# Four recurring prices, created in Stripe Dashboard > Product catalog
# (two products, "Growth" and "Pro", each with a monthly + annual price —
# annual priced at ~10x monthly, i.e. 2 months free).
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Only exists once a webhook endpoint is registered against a real,
# reachable URL (Stripe Dashboard > Developers > Webhooks > Add endpoint,
# pointed at https://spectecle.com/api/webhooks/stripe, listening for
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, and invoice.payment_failed) — so this
# can't be filled in until after deploy.
STRIPE_WEBHOOK_SECRET=
